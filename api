module.exports = async (req, res) => {
    if (req.method === 'POST') {
        try {
            const update = req.body || {};
            await handleUpdate(update);
        } catch (err) {
            console.error(err);
        }
        return res.status(200).send('OK');
    }
    return res.status(200).send('Bot is running on Vercel ⚡');
};
